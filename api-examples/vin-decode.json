    },
    "glass": {
      "layout": "pickup",
      "panels": ["windshield", "back_glass", "front_left_door", "front_right_door", "rear_left_door", "rear_right_door"],
      "features": {
        "adas": true,
        "rain_sensor": true,
        "heated": true
      }
    },
    "pricing": {
      "windshield": {
        "base": [200, 400],
        "with_features": [380, 600],
        "modifiers_applied": ["adas", "rain_sensor", "heated"]
      }
    },
    "confidence": 0.90,
    "sources": ["nhtsa", "derived"]
  }
}
