        "alaska_shipping": 75,
        "availability": "common"
      },
      "total_estimate": [600, 800],
      "recalibration": {
        "required": true,
        "estimated_cost": [150, 350]
      },
      "labor_estimate": [80, 150]
    },
    "grand_total": [830, 1300],
    "confidence": 0.88,
    "disclaimer": "Prices are estimates. Final pricing depends on vehicle inspection, trim level, and parts availability."
  }
