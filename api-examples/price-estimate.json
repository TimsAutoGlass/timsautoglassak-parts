{
  "endpoint": "POST /price/estimate",
  "description": "Get price estimate for glass replacement including features and Alaska adjustments",
  "request": {
    "year": 2023,
    "make": "FORD",
    "model": "F-150",
    "panel": "windshield",
    "region": "alaska"
  },
  "response": {
    "success": true,
    "vehicle": {
      "year": 2023,
      "make": "FORD",
      "model": "F-150",
      "body_class": "PICKUP"
    },
    "estimate": {
      "panel": "windshield",
      "glass_type": "laminated",
      "base_price": [200, 400],
      "features_detected": ["adas", "rain_sensor", "heated"],
