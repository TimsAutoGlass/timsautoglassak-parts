# AUTO GLASS INTELLIGENCE - ENVIRONMENT VARIABLES
# Copy this file to .env locally. For GitHub Actions, add these as Repository Secrets.

# 1. eBay Motors API (For baseline Part Numbers and aftermarket cash pricing)
# Get this from developer.ebay.com
EBAY_APP_ID="your_ebay_app_id_here"
EBAY_CERT_ID="your_ebay_cert_id_here"

# 2. B2B Wholesale Portals (Future Use / When Available)
MYGRANT_USERNAME="your_mygrant_user"
MYGRANT_PASSWORD="your_mygrant_password"

# 3. Scraping Configuration
# Delay between competitive scrape requests (to avoid banning from Glass.net/Safelite)
SCRAPE_DELAY_MS=2000
